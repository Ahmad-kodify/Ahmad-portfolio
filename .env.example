# Copy to .env and fill in. Never commit the real .env.

# ---- server -----------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Where the SQLite file lives. Point at a persistent volume in production.
DATABASE_FILE=./data/portfolio.db

# Signs the admin session cookie. Must be >= 32 characters in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---- admin account (used by: npm run admin:create) ---------------------------
ADMIN_EMAIL=ahmadkodify@gmail.com
ADMIN_PASSWORD=

# ---- email notifications (optional — leave blank to disable) -----------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# "From" address on outgoing mail (defaults to SMTP_USER).
MAIL_FROM=
# Where the "new feedback" alert is sent.
OWNER_EMAIL=ahmadkodify@gmail.com
SITE_NAME=Muhammad Ahmad — Portfolio
# Link included in the alert email.
ADMIN_URL=http://localhost:5173/admin

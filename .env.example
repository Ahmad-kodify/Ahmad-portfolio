# Copy to .env.local and fill in. Never commit real secrets.

# Public site URL — used for canonical links, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://arkar.co.uk

# ---- Contact form delivery (optional) ---------------------------------------
# When SMTP_HOST is set, /api/contact emails every submission to CONTACT_TO.
# Leave SMTP_HOST blank and submissions are logged to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# "From" address on outgoing mail (defaults to SMTP_USER).
MAIL_FROM=
# Where new enquiries are delivered.
CONTACT_TO=hello@arkar.co.uk
